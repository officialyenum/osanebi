@inherits LayoutComponentBase
@inject IJSRuntime jsRuntime

<MudThemeProvider @bind-IsDarkMode="@_isDarkMode" Theme="_theme" />
<MudPopoverProvider />

<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    <MudAppBar>
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start" OnClick="@((e) => DrawerToggle())" />
        Osanebi
    </MudAppBar>
    <MudIconButton Icon="@_currentIcon" Color="Color.Inherit" Edge="Edge.End" OnClick="@((e) => DarkModeToggle())" />
    <MudDrawer @bind-Open="@_drawerOpen">
        <NavMenu/>
    </MudDrawer>
    <MudMainContent>
        @Body
    </MudMainContent>
</MudLayout>

@code {
    bool _drawerOpen = true;
    bool _isDarkMode = false;
    string _currentIcon = Icons.Material.Filled.DarkMode;
    MudTheme _theme = new MudTheme()
    {
        PaletteLight = new PaletteLight()
        {
            Primary = Colors.Blue.Default,
            AppbarBackground = Colors.Blue.Default,
        },
        PaletteDark = new PaletteDark()
        {
            Primary = Colors.Blue.Lighten2,
            AppbarBackground = Colors.Blue.Lighten2
        }
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            var darkModeSetting = await jsRuntime.InvokeAsync<string>("localStorage.getItem", "dark-mode");
            if (!string.IsNullOrEmpty(darkModeSetting) && bool.TryParse(darkModeSetting, out bool isDarkMode))
            {
                _isDarkMode = isDarkMode;
                _currentIcon = _isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.Brightness4;
                StateHasChanged();
            }
        }
        
    }
    
    void DrawerToggle()
    {
        _drawerOpen = !_drawerOpen;
    }
    
    private async Task DarkModeToggle()
    {
        _isDarkMode = !_isDarkMode;
        _currentIcon = _isDarkMode ? Icons.Material.Filled.DarkMode : Icons.Material.Filled.Brightness4;
        await jsRuntime.InvokeVoidAsync("localStorage.setItem", "dark-mode", _isDarkMode.ToString());
    }
}
