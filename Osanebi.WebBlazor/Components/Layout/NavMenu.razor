@inject IStringLocalizer<Resource> localizer;

<MudNavMenu>
    <MudNavLink Href="/" Match="NavLinkMatch.All">Home</MudNavLink>
    <MudNavLink Href="/identity/user-profile" Match="NavLinkMatch.Prefix">@localizer["title-user-profile"]</MudNavLink>
    <MudNavGroup Title="Identity" Expanded="true">
        <MudNavLink Href="/identity/login" Match="NavLinkMatch.Prefix">@localizer["title-login"]</MudNavLink>
        <MudNavLink Href="/identity/register" Match="NavLinkMatch.Prefix">@localizer["title-register"]</MudNavLink>
    </MudNavGroup>
    <MudNavLink Href="/about" Match="NavLinkMatch.Prefix">@localizer["title-about"]</MudNavLink>
</MudNavMenu>

