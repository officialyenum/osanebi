@page "/identity/login"

@inject IStringLocalizer<Resource> localizer
@inject NavigationManager navigationManager
@inject IJSRuntime jsRuntime
@inject IAuthenticationService authenticationService

<MudPaper Style="position:relative", Class="pa-4" Outlined="false" Square="false" Elevation="0">
    <MudText Typo="Typo.h3">@localizer["title-login"]</MudText>
    <MudGrid>
        <MudItem xs="12" sm="7">
            <MudPaper Class="pa-4">
                <MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors" Model="@_model" Disabled="@_loading">
                    <MudTextField T="string"
                        Label=@localizer["input-email"] 
                        @bind-Value="_model.Email" 
                        Required="true" 
                        RequiredError="@localizer["message-email-required"]"
                        Validation="@(new EmailOnlyAttribute { ErrorMessage = @localizer["message-email-format"] })" />
                    <MudTextField T="string"
                        @bind-Value="_model.Password"
                        Label=@localizer["input-password"]
                        HelperText="Choose a strong password"
                        InputType="InputType.Password"
                        Validation="@(new PasswordAttribute() { ErrorMessage = @localizer["message-password-validation"] })"
                        Required="true"
                        RequiredError="@localizer["message-password-required"]" />

                    <div class="d-flex align-center justify-space-between mt-4">
                        <MudSpacer/>
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" DropShadow="false" OnClick="@(() => {_form.ResetAsync(); _form.ResetValidationAsync();})" Class="mx-2">@localizer["btn-reset"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="@(!_success)" Class="ml-auto" OnClick="@(async () => await SubmitForm())">@localizer["btn-login"]</MudButton>
                    </div>
                    <div class="d-flex align-center justify-space-between mt-4">

                        <MudSpacer />
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/identity/confirm-email">@localizer["link-confirm-email"]</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="/identity/forget-password">@localizer["link-forget-password"]</MudButton>
                        <MudSpacer />
                    </div>
                </MudForm>
            </MudPaper>
        </MudItem>
        
        <MudItem xs="12" sm="5">
            <ErrorDisplay Errors="@_errors" />
        </MudItem>
    </MudGrid>
    <LoadingSpinner Loading="@_loading" />
</MudPaper>

@code {
    bool _success;
    bool _loading = false;
    string[] _errors = [];
    MudForm _form = new();
    ApplicationUserLoginInputModel _model = new ApplicationUserLoginInputModel { Email = "", Password = "" };
    
    private async Task SubmitForm()
    {
        _loading = true;
        var response = await authenticationService.LoginAsync(_model);
        _loading = false;
        if (response.IsSuccess)
        {
                navigationManager.NavigateTo("Identity/UserProfile");
        }
        else 
        {
            _errors = new string[] { response.Message ?? string.Empty };
         }
        
    }
}