@page "/identity/register"

@using Osanebi.Model.ApplicationModels
@using Osanebi.Model.InputModels
@using Osanebi.WebBlazor.Validator
@using Osanebi.Model.Enums
@using System.Text.RegularExpressions
@using System.ComponentModel.DataAnnotations

@inject HttpClient http
@inject IStringLocalizer<Resource> localizer
@inject NavigationManager navigationManager

<MudPaper Style="position:relative" , Class="pa-4" Outlined="false" Square="false" Elevation="0">
    <MudText Typo="Typo.h3">@localizer["title-register"]</MudText>
    <MudGrid>
        <MudItem xs="12" sm="7">
            <MudPaper Class="pa-4">
                <MudForm @ref="_form" @bind-IsValid="@_success" @bind-Errors="@_errors" Model="@_model" Disabled="@_loading">
                    <MudTextField T="string"
                                  Label=@localizer["input-firstname"]
                                  @bind-Value="_model.FirstName"
                                  Required="true"
                                  RequiredError="@localizer["message-firstname-required"]"
                                  Class="mt-4"/>
                    <MudTextField T="string"
                                  Label=@localizer["input-lastname"]
                                  @bind-Value="_model.LastName"
                                  Required="true"
                                  RequiredError="@localizer["message-lastname-required"]"
                                  Class="mt-4" />
                    <MudSelect T="string" Label="@localizer["input-gender"]" ValueChanged="@(value => UpdateGender(value))" Class="mt-4">
                        @foreach (var gender in GetLocalizedGenderArrayFromEnum())
                        {
                            <MudSelectItem Value="@gender.Key.ToString()">@gender.Value</MudSelectItem>
                        }
                    </MudSelect>
                    <MudDatePicker T="DateTime" 
                        Label="@localizer["input-dob"]" 
                        DateChanged="@(value => _model.DateOfBirth = value)"
                        Class="mt-4" />
                    <MudTextField T="string"
                                  Label=@localizer["input-email"]
                                  @bind-Value="_model.Email"
                                  Required="true"
                                  RequiredError="@localizer["message-email-required"]"
                                  Validation="@(new EmailOnlyAttribute { ErrorMessage = @localizer["message-email-format"] })" />
                    <MudTextField T="string"
                                  @bind-Value="_model.Password"
                                  Label=@localizer["input-password"]
                                  HelperText="Choose a strong password"
                                  InputType="InputType.Password"
                                  Validation="@(new PasswordAttribute() { ErrorMessage = @localizer["message-password-validation"] })"
                                  Required="true"
                                  RequiredError="@localizer["message-password-required"]" />
                    <MudTextField T="string"
                                  @bind-Value="_model.ConfirmPassword"
                                  Label=@localizer["input-confirm-password"]
                                  HelperText="Choose a strong password"
                                  InputType="InputType.Password"
                                  Validation="@(new PasswordAttribute() { ErrorMessage = @localizer["message-confirm-password-validation"] })"
                                  Required="true"
                                  RequiredError="@localizer["message-confirm-password-required"]" />

                    <div>

                        <MudSpacer />
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" DropShadow="false" OnClick="@(() => { _form.ResetAsync(); _form.ResetValidationAsync(); })" Class="mx-2">@localizer["btn-reset"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Secondary" Disabled="@(!_success)" Class="ml-auto" OnClick="@(async () => await HandleValidSubmit())">@localizer["btn-register"]</MudButton>
                    </div>
                </MudForm>
            </MudPaper>
        </MudItem>

        <MudItem xs="12" sm="5">
            <ErrorDisplay Errors="@_errors" />
        </MudItem>
    </MudGrid>
    <LoadingSpinner Loading="@_loading" />
</MudPaper>

@code {
    bool _success;
    bool _loading = false;
    string[] _errors = Array.Empty<string>();
    MudForm _form = new();
    ApplicationUserRegisterInputModel _model = new ApplicationUserRegisterInputModel { 
        FirstName = "",
        LastName = "",
        Email = "", 
        Password = "",
        ConfirmPassword = "",
    };

    private async Task HandleValidSubmit()
    {
        ChangeLoadingState();
        var response = await http.PostAsJsonAsync("Identity/Authentication/register", _model);
        ChangeLoadingState();
        if (response.IsSuccessStatusCode)
        {
            navigationManager.NavigateTo("Identity/login");
        }
        else
        {
            var errorResponse = await response.Content.ReadFromJsonAsync<ResponseModel<bool>>();
            var localizedErrorMessage = GetLocalizedErrorMessage(errorResponse?.Message ?? "message-unknown-error");
            _errors = new string[] { localizedErrorMessage };
        }
    }

    private void ChangeLoadingState()
    {
        _loading = !_loading;
    }

    private string? PasswordMatch(string password, string confirmPassword)
    {
        if (_model.Password != confirmPassword)
        {
            return localizer["message-confirm-password-match"];
        }
        return null;
    }

    string GetLocalizedErrorMessage(string errorMessage)
    {
        var resourceKey = GetResourceKeyForApiMessage(errorMessage);
        return localizer[resourceKey];
    }

    string GetResourceKeyForApiMessage(string errorMessage)
    {
        return errorMessage switch
        {
            "DuplicateUsername" => "message-email-exists",
            _ => "message-unknown-error"
        };
    }

    private KeyValuePair<Gender, string>[] GetLocalizedGenderArrayFromEnum()
    {
        return Enum.GetValues(typeof(Gender))
            .Cast<Gender>()
            .Select(gender => new KeyValuePair<Gender, string>(gender, localizer[$"gender-{gender}"].Value))
            .ToArray();
    }

    private void UpdateGender(string selectedGender)
    {
        if (Enum.TryParse<Gender>(selectedGender, out var parsedGender))
        {
            _model.Gender = parsedGender;
        }
        else
        {
            _model.Gender = null;
        }
    }
}
