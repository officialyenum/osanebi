@page "/"
@inject HttpClient http
@inject IStringLocalizer<Resource> localizer;

<PageTitle>Home</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <h1>Hello, world!</h1>
    <p>@localizer["message-welcome"]</p>
    <p>@apiUrl</p>
    <p>@apiResponse</p>
</MudContainer>

@code {
    private string apiResponse = string.Empty;
    private string apiUrl = "PublicArea/Public";

    protected override async Task OnInitializedAsync()
    {
        await FetchData();
    }

    private async Task FetchData()
    {
        try
        {
            apiUrl = $"{http.BaseAddress}";
            apiResponse = await http.GetStringAsync("PublicArea/Public");
        }
        catch (Exception ex)
        {
            apiResponse = $"Error fetching data: {ex.Message}";
        }
    }
}
